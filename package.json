{
    "name": "dosepehr.github.io",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "description": "Landing page and documentation for the Frontend Foundation component library.",
    "scripts": {
        "foundation:sync": "node scripts/sync-foundation.mjs",
        "generate": "node scripts/generate/index.mjs",
        "dev": "node scripts/dev.mjs",
        "prebuild": "npm run foundation:sync && npm run generate",
        "build": "next build",
        "start": "npx serve out",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\"",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "prepare": "husky"
    },
    "dependencies": {
        "@base-ui/react": "^1.5.0",
        "@hookform/resolvers": "^5.4.0",
        "@sentry/nextjs": "^10.70.0",
        "@tanstack/react-table": "^8.21.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "fumadocs-core": "16.18.2",
        "fumadocs-mdx": "15.5.1",
        "fumadocs-ui": "16.18.2",
        "input-otp": "^1.4.2",
        "lucide-react": "^1.17.0",
        "motion": "^12.40.0",
        "next": "16.2.6",
        "next-themes": "^0.4.6",
        "radix-ui": "^1.4.3",
        "react": "19.2.4",
        "react-day-picker": "^10.0.1",
        "react-dom": "19.2.4",
        "react-error-boundary": "^6.1.2",
        "react-hook-form": "^7.79.0",
        "react-resizable-panels": "^4.12.1",
        "shadcn": "^4.12.0",
        "shiki": "^4.6.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "universal-cookie": "^8.1.2",
        "vaul": "^1.1.2",
        "zod": "^4.4.3",
        "zustand": "^5.0.14"
